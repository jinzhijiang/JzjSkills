# 凭据按项目隔离，脚本按 git 根目录名去找：
#   ~/.config/ai-ignore-config/<项目名>/countly.env
# 一个 Countly 实例挂着多个 App，共用一份配置会让你从 A 项目查到 B 项目的数据，
# 数据看着正常但不是你要的那个应用——所以一个项目一份。
#
# COUNTLY_APP_ID: Dashboard → 应用管理 → 应用ID（也在 dashboard URL 里）
# COUNTLY_TOKEN:  Dashboard 登录后从浏览器 devtools 复制 auth_token，
#                 或 User Profile → API Key（长期有效；脚本目前按 auth_token 参数传）
# COUNTLY_BASE:   可选，默认 https://analytics.jzj.plus/o
#
# 首次配置（以 flutter_bbjz 为例）：
#   mkdir -p ~/.config/ai-ignore-config/flutter_bbjz
#   cp config.example.env ~/.config/ai-ignore-config/flutter_bbjz/countly.env
#   # 然后填 COUNTLY_APP_ID 与 COUNTLY_TOKEN
#
# 临时切 App 而不想动配置文件：--config /path/to/other.env，或 export COUNTLY_CONFIG=...

COUNTLY_BASE=https://analytics.jzj.plus/o
COUNTLY_APP_ID=
COUNTLY_TOKEN=
